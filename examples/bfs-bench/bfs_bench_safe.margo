@import std/io
@import std/file
@import std/string

@style c {
    typedef struct FILE FILE;

    struct Graph {
        uint32_t num_nodes;
        uint64_t num_edges;
        uint64_t *offsets;
        uint32_t *edges;
    };

    struct BFSStats {
        uint64_t visited_nodes;
        uint64_t distance_sum;
        int32_t max_distance;
    };

    extern FILE *fopen(const char *path, const char *mode);
    extern int fclose(FILE *stream);
    extern size_t fread(void *ptr, size_t size, size_t count, FILE *stream);
}

fn weird(FILE, 1) safe_open_readonly(string path) {
    weird(FILE, 1) file = fopen(path, "rb")
    if !file {
        print("Failed to open", path)
    }
    return file
}

fn safe_read_exact(weird(FILE, 1) file, weird(void, 1) ptr, size_t size, size_t count, string fail_message) {
    if fread(ptr, size, count, file) != count {
        print(fail_message)
        return 1
    }
    return 0
}

fn safe_close(weird(FILE, 1) file) {
    if !file return
    fclose(file)
}

fn void release_graph(weird(struct Graph, 1) graph) {
    if !graph return
    graph->offsets = NULL
    graph->edges = NULL
    graph->num_nodes = 0
    graph->num_edges = 0
}

fn load_graph(string path, weird(struct Graph, 1) graph) {
    weird(FILE, 1) file = safe_open_readonly(path)
    if !file return 1

    uint32_t nodes = 0
    uint64_t edges = 0
    if safe_read_exact(file, &nodes, 4, 1, "Failed to read graph header") != 0 {
        safe_close(file)
        return 1
    }
    if safe_read_exact(file, &edges, 8, 1, "Failed to read graph header") != 0 {
        safe_close(file)
        return 1
    }

    graph->offsets = alloc((nodes + 1) * sizeof(uint64_t))
    graph->edges = edges > 0 ? alloc(edges * sizeof(uint32_t)) : NULL

    if !graph->offsets || (edges > 0 && !graph->edges) {
        print("Out of memory while loading graph")
        safe_close(file)
        return 1
    }
    if safe_read_exact(file, graph->offsets, 8, nodes + 1, "Failed to read offset table") != 0 {
        safe_close(file)
        return 1
    }

    if edges > 0 && safe_read_exact(file, graph->edges, 4, edges, "Failed to read edge list") != 0 {
        safe_close(file)
        return 1
    }
    safe_close(file)

    if graph->offsets[nodes] != edges {
        print("Graph file corrupted")
        return 1
    }

    graph->num_nodes = nodes
    graph->num_edges = edges
    return 0
}

fn run_bfs(weird(struct Graph, 1) graph, weird(struct BFSStats, 1) stats) {
    if !graph || graph->num_nodes == 0 {
        print("Graph is empty.")
        return 1
    }

    auto node_count = graph->num_nodes
    weird(uint32_t, 1) queue = alloc(node_count * sizeof(uint32_t))
    weird(int32_t, 1) distances = alloc(node_count * sizeof(int32_t))

    if !queue || !distances {
        return 1
    }

    for i = 0; < node_count; ++ {
        distances[i] = -1
    }

    auto head = 0
    auto tail = 0
    auto size = 0

    queue[tail] = 0
    tail = (tail + 1 == node_count) ? 0 : (tail + 1)
    size = 1
    distances[0] = 0

    auto visited = 1
    auto distance_sum = 0
    auto max_distance = 0

    while size > 0 {
        auto node = queue[head]
        head = (head + 1 == node_count) ? 0 : (head + 1)
        size--

        auto base_distance = distances[node]
        auto begin = graph->offsets[node]
        auto end = graph->offsets[node + 1]

        for idx = begin; < end; ++ {
            auto neighbor = graph->edges[idx]
            if distances[neighbor] != -1 continue

            auto next_distance = base_distance + 1
            distances[neighbor] = next_distance
            queue[tail] = neighbor
            tail = (tail + 1 == node_count) ? 0 : (tail + 1)
            size++
            visited++
            distance_sum += next_distance
            if next_distance > max_distance {
                max_distance = next_distance
            }
        }
    }

    stats->visited_nodes = visited
    stats->distance_sum = distance_sum
    stats->max_distance = max_distance
    return 0
}

fn start(int argC, weird(char, 2) argV) {
    string graph_path = "graph.bin"
    if argC > 1 {
        graph_path = argV[1]
    }

    struct Graph graph = {0}
    if load_graph(graph_path, &graph) != 0 {
        release_graph(&graph)
        return 1
    }

    struct BFSStats stats = {0}
    if run_bfs(&graph, &stats) != 0 {
        release_graph(&graph)
        return 1
    }

    print("=== BFS (Margo Safe Allocator) ===")
    print("Nodes: ", graph.num_nodes, "  Edges: ", graph.num_edges, sep = "")
    print("Visited nodes: ", stats.visited_nodes, sep = "")
    print("Distance sum: ", stats.distance_sum, "  Max distance: ", stats.max_distance, sep = "")

    release_graph(&graph)
    return 0
}
