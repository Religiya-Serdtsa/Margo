@import std/io
@import std/file
@import std/string
@import c/stdint
@import matrix/core

struct Graph {
    uint32_t num_nodes
    uint64_t num_edges
    uint64_t *offsets
    uint32_t *edges
}

struct BFSStats {
    uint64_t visited_nodes
    uint64_t distance_sum
    int32_t max_distance
}

fn weird(FILE, 1) safe_open_readonly(string path) {
    weird(FILE, 1) file = fopen(path, "rb")
    if !file {
        print("Failed to open", path)
    }
    return file
}

fn safe_read_exact(weird(FILE, 1) file, weird(void, 1) ptr, size_t size, size_t count, string fail_message) {
    if fread(ptr, size, count, file) != count {
        print(fail_message)
        return 1
    }
    return 0
}

fn void safe_close(weird(FILE, 1) file) {
    if !file return
    fclose(file)
}

fn void release_graph(weird(struct Graph, 1) graph) {
    if !graph return
    graph->offsets = NULL
    graph->edges = NULL
    graph->num_nodes = 0
    graph->num_edges = 0
}

fn size_t guard_graph_stream(weird(FILE, 1) file) {
    if !file return 0
    auto current = ftell(file)
    if current < 0 {
        return 0
    }
    if fseek(file, 0, SEEK_END) != 0 {
        return 0
    }
    auto end_pos = ftell(file)
    if end_pos < 0 {
        return 0
    }
    if fseek(file, 0, SEEK_SET) != 0 {
        return 0
    }
    return (size_t)end_pos
}

fn load_graph(string path, weird(struct Graph, 1) graph) {
    weird(FILE, 1) file = safe_open_readonly(path)
    if !file return 1
    size_t file_bytes = guard_graph_stream(file)
    if file_bytes == 0 {
        safe_close(file)
        return 1
    }

    uint32_t nodes = 0
    uint64_t edges = 0
    if safe_read_exact(file, &nodes, 4, 1, "Failed to read graph header") != 0 {
        safe_close(file)
        return 1
    }
    if safe_read_exact(file, &edges, 8, 1, "Failed to read graph header") != 0 {
        safe_close(file)
        return 1
    }

    graph->offsets = alloc((nodes + 1) * sizeof(uint64_t))
    graph->edges = edges > 0 ? alloc(edges * sizeof(uint32_t)) : NULL

    if !graph->offsets || (edges > 0 && !graph->edges) {
        print("Out of memory while loading graph")
        safe_close(file)
        return 1
    }
    if safe_read_exact(file, graph->offsets, 8, nodes + 1, "Failed to read offset table") != 0 {
        safe_close(file)
        return 1
    }

    if edges > 0 && safe_read_exact(file, graph->edges, 4, edges, "Failed to read edge list") != 0 {
        safe_close(file)
        return 1
    }
    safe_close(file)

    // Treat the serialized graph as a flattened linear-algebra vector and verify its length.
    size_t expected_bytes = sizeof(uint32_t) + sizeof(uint64_t)
    expected_bytes += (size_t)(nodes + 1) * sizeof(uint64_t)
    expected_bytes += (size_t)edges * sizeof(uint32_t)
    if file_bytes != expected_bytes {
        print("Graph file size mismatch (expected ", expected_bytes, ", saw ", file_bytes, " bytes)", sep = "")
        return 1
    }

    if graph->offsets[nodes] != edges {
        print("Graph file corrupted")
        return 1
    }

    graph->num_nodes = nodes
    graph->num_edges = edges
    return 0
}

fn run_bfs(weird(struct Graph, 1) graph, weird(struct BFSStats, 1) stats) {
    if !graph || graph->num_nodes == 0 {
        print("Graph is empty.")
        return 1
    }

    uint32_t node_count = graph->num_nodes
    auto_matrix queue = matrix_alloc(1, node_count)
    auto_matrix distances = matrix_alloc(1, node_count)

    if !queue || !distances {
        return 1
    }

    double *queue_view = matrix_row_ptr(queue, 0)
    double *distance_view = matrix_row_ptr(distances, 0)
    if !queue_view || !distance_view {
        return 1
    }
    uint64_t *queue_slots = (uint64_t *)queue_view
    uint64_t *distance_slots = (uint64_t *)distance_view
    if !queue_slots || !distance_slots {
        return 1
    }
    uint8_t *visited_mask = alloc(node_count)
    if !visited_mask {
        return 1
    }
    uint32_t visit_idx = 0
    for visit_idx = 0; < node_count; ++ {
        visited_mask[visit_idx] = 0
    }

    uint32_t head = 0
    uint32_t tail = 0
    uint32_t size = 0

    queue_slots[tail] = 0
    tail = (tail + 1 == node_count) ? 0 : (tail + 1)
    size = 1
    distance_slots[0] = 0
    visited_mask[0] = 1

    uint64_t visited = 1
    uint64_t distance_sum = 0
    int32_t max_distance = 0

    while size > 0 {
        uint32_t node = (uint32_t)queue_slots[head]
        head = (head + 1 == node_count) ? 0 : (head + 1)
        size--

        int32_t base_distance = (int32_t)distance_slots[node]
        uint64_t begin = graph->offsets[node]
        uint64_t end = graph->offsets[node + 1]

        for idx = begin; < end; ++ {
            uint32_t neighbor = graph->edges[idx]
            if (visited_mask[neighbor]) continue
            if (idx + 32 < end) {
                __builtin_prefetch(&graph->edges[idx + 32])
            }

            int32_t next_distance = base_distance + 1
            distance_slots[neighbor] = (uint64_t)next_distance
            queue_slots[tail] = neighbor
            tail = (tail + 1 == node_count) ? 0 : (tail + 1)
            size++
            visited++
            distance_sum += (uint64_t)next_distance
            if next_distance > max_distance {
                max_distance = next_distance
            }
            visited_mask[neighbor] = 1
        }
    }

    stats->visited_nodes = visited
    stats->distance_sum = distance_sum
    stats->max_distance = max_distance
    return 0
}

fn start(int argC, weird(char, 2) argV) {
    string graph_path = "graph.bin"
    if argC > 1 {
        graph_path = argV[1]
    }

    struct Graph graph = {0}
    if load_graph(graph_path, &graph) != 0 {
        release_graph(&graph)
        return 1
    }

    struct BFSStats stats = {0}
    if run_bfs(&graph, &stats) != 0 {
        release_graph(&graph)
        return 1
    }

    print("=== BFS (Margo Safe Allocator) ===")
    print("Nodes: ", graph.num_nodes, "  Edges: ", graph.num_edges, sep = "")
    print("Visited nodes: ", stats.visited_nodes, sep = "")
    print("Distance sum: ", stats.distance_sum, "  Max distance: ", stats.max_distance, sep = "")

    release_graph(&graph)
    return 0
}
