@import c/errno.h
@import c/inttypes.h
@import c/stdio.h
@import c/stdlib.h
@import c/string.h
@import matrix/core

@style c {
    struct Graph {
        uint32_t num_nodes;
        uint64_t num_edges;
        uint64_t *offsets;
        uint32_t *edges;
    };

    struct BFSStats {
        uint64_t visited_nodes;
        uint64_t distance_sum;
        int32_t max_distance;
    };
}

fn void release_graph(weird(struct Graph, 1) graph) {
    if !graph return
    free(graph->offsets)
    free(graph->edges)
    graph->offsets = NULL
    graph->edges = NULL
    graph->num_nodes = 0
    graph->num_edges = 0
}

fn load_graph(string path, weird(struct Graph, 1) graph) {
    weird(FILE, 1) file = fopen(path, "rb")
    if !file {
        print("Failed to open", path)
        return 1
    }

    uint32_t nodes = 0
    uint64_t edges = 0
    if fread(&nodes, 4, 1, file) != 1 || fread(&edges, 8, 1, file) != 1 {
        print("Failed to read graph header")
        fclose(file)
        return 1
    }

    weird(uint64_t, 1) offsets = malloc((nodes + 1) * 8)
    weird(uint32_t, 1) edge_list = edges > 0 ? malloc(edges * 4) : NULL

    if !offsets || (edges > 0 && !edge_list) {
        print("Out of memory while loading graph")
        free(offsets)
        free(edge_list)
        fclose(file)
        return 1
    }

    if fread(offsets, 8, nodes + 1, file) != nodes + 1 {
        print("Failed to read offset table")
        free(offsets)
        free(edge_list)
        fclose(file)
        return 1
    }

    if edges > 0 && fread(edge_list, 4, edges, file) != edges {
        print("Failed to read edge list")
        free(offsets)
        free(edge_list)
        fclose(file)
        return 1
    }
    fclose(file)

    if offsets[nodes] != edges {
        print("Graph file corrupted")
        free(offsets)
        free(edge_list)
        return 1
    }

    graph->num_nodes = nodes
    graph->num_edges = edges
    graph->offsets = offsets
    graph->edges = edge_list
    return 0
}

fn run_bfs(weird(struct Graph, 1) graph, weird(struct BFSStats, 1) stats) {
    if !graph || graph->num_nodes == 0 {
        print("Graph is empty.")
        return 1
    }

    uint32_t node_count = graph->num_nodes
    auto_matrix queue = malloc(sizeof(margo_matrix) + (size_t)node_count * sizeof(double))
    auto_matrix distances = malloc(sizeof(margo_matrix) + (size_t)node_count * sizeof(double))

    if !queue || !distances {
        free(queue)
        free(distances)
        return 1
    }
    queue->rows = 1
    queue->cols = node_count
    distances->rows = 1
    distances->cols = node_count

    double *queue_view = matrix_row_ptr(queue, 0)
    double *distance_view = matrix_row_ptr(distances, 0)
    if !queue_view || !distance_view {
        free(queue)
        free(distances)
        return 1
    }
    uint64_t *queue_slots = (uint64_t *)queue_view
    uint64_t *distance_slots = (uint64_t *)distance_view
    uint8_t *visited_mask = malloc(node_count)
    if !visited_mask {
        return 1
    }
    memset(visited_mask, 0, node_count)

    uint32_t head = 0
    uint32_t tail = 0
    uint32_t size = 0

    queue_slots[tail] = 0
    tail = (tail + 1 == node_count) ? 0 : (tail + 1)
    size = 1
    distance_slots[0] = 0
    visited_mask[0] = 1

    uint64_t visited = 1
    uint64_t distance_sum = 0
    int32_t max_distance = 0

    while size > 0 {
        uint32_t node = (uint32_t)queue_slots[head]
        head = (head + 1 == node_count) ? 0 : (head + 1)
        size--

        int32_t base_distance = (int32_t)distance_slots[node]
        uint64_t begin = graph->offsets[node]
        uint64_t end = graph->offsets[node + 1]

        for idx = begin; < end; ++ {
            uint32_t neighbor = graph->edges[idx]
            if (visited_mask[neighbor]) continue
            if (idx + 32 < end) {
                __builtin_prefetch(&graph->edges[idx + 32])
            }

            int32_t next_distance = base_distance + 1
            distance_slots[neighbor] = (uint64_t)next_distance
            queue_slots[tail] = neighbor
            tail = (tail + 1 == node_count) ? 0 : (tail + 1)
            size++
            visited++
            distance_sum += (uint64_t)next_distance
            if next_distance > max_distance {
                max_distance = next_distance
            }
            visited_mask[neighbor] = 1
        }
    }

    free(visited_mask)
    free(queue)
    free(distances)
    stats->visited_nodes = visited
    stats->distance_sum = distance_sum
    stats->max_distance = max_distance

    return 0
}

fn start(int argC, weird(char, 2) argV) {
    string graph_path = "graph.bin"
    if argC > 1 {
        graph_path = argV[1]
    }

    struct Graph graph = {0}
    if load_graph(graph_path, &graph) != 0 {
        release_graph(&graph)
        return 1
    }

    struct BFSStats stats = {0}
    if run_bfs(&graph, &stats) != 0 {
        release_graph(&graph)
        return 1
    }

    print("=== BFS (Margo Native) ===")
    print("Nodes: ", graph.num_nodes, "  Edges: ", graph.num_edges, sep = "")
    print("Visited nodes: ", stats.visited_nodes, sep = "")
    print("Distance sum: ", stats.distance_sum, "  Max distance: ", stats.max_distance, sep = "")

    release_graph(&graph)
    return 0
}
