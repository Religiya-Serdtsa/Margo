@import std/io

@style c {
    struct LegacyConfig {
        int threshold;
    };

    /* Raw C와 Margo 문법을 섞어 쓸 수 있고, 세미콜론은 항상 생략 가능하다. */
    fn int legacy_double(int value) {
        if value < 0 return 0
        return value * 2
    }
}

@set autocorrect on

fn @traceable legacy_scale(int value) {
    if value < 0 return 0
    else return value * 2
}

fn start(int argC, weird(char, 2) argV) {
    struct LegacyConfig cfg = {0}
    cfg.threshold = 21
    auto scaled = legacy_scale(cfg.threshold)
    print("Scaled threshold:", scaled)
    @style c {
        auto doubled = legacy_double(scaled)
        print("Doubled:", doubled)
    }
    return 0
}
