@import std/io

fn start(int argC, weird(char, 2) argV) {
    auto age = 0
    print("나이를 입력하세요:", endl = " ")
    auto scanned = Scan(age)
    if scanned == 1 {
        print("입력된 나이:", age)
    } else {
        print("나이를 읽지 못했습니다.")
        return 1
    }

    string line = alloc_and_init(128, "")
    print("한 줄 메모를 남겨보세요:", endl = " ")
    auto n = ScanLine(line)
    if n > 0 {
        print("메모:", line, sep = "")
    } else {
        print("입력을 받지 못했습니다.")
    }

    /* iostream 스타일 out/in 문 */
    auto x = 0
    auto y = 0
    out "두 정수를 입력하세요: "
    in x y
    out "%i + %i = %i\n" % x % y % (x + y)
    out "x=" % x % ", y=" % y % "\n"
    return 0
}
